<ul>
<li><em>13 May 2011</em>
    by Stefan Wischhusen:<br>
       Corrected the required unit of parameter MM.</li>
</ul>
</html>"));
            end TwoPhaseFlowHT_IN_con;

            record TwoPhaseFlowHT_IN_var "Base record for two phase heat transfer coefficient"
              extends Modelica.Icons.Record;
              //choices
              Modelica.Fluid.Dissipation.Utilities.Types.TwoPhaseHeatTransferTarget target = Modelica.Fluid.Dissipation.Utilities.Types.TwoPhaseHeatTransferTarget.BoilHor "Choice of (horizontal/vertical) boiling or (horizontal) condensation in pipe" annotation(
                Dialog(group = "Choices"));
              //fluid properties
              SI.SpecificHeatCapacityAtConstantPressure cp_l "Specific heat capacity of liquid" annotation(
                Dialog(group = "Fluid properties"));
              SI.ThermalConductivity lambda_l "Thermal conductivity of liquid" annotation(
                Dialog(group = "Fluid properties"));
              SI.Density rho_g "Density of gas" annotation(
                Dialog(group = "Fluid properties", enable = if target == Modelica.Fluid.Dissipation.Utilities.Types.TwoPhaseHeatTransferTarget.BoilHor or target == Modelica.Fluid.Dissipation.Utilities.Types.TwoPhaseHeatTransferTarget.BoilVer then true else false));
              SI.Density rho_l "Density of liquid" annotation(
