        Pipes.DynamicPipe pipe11(use_T_start = true, diameter = 2.5e-2, redeclare package Medium = Medium, modelStructure = pipeModelStructure, redeclare model FlowModel = Modelica.Fluid.Pipes.BaseClasses.FlowModels.TurbulentPipeFlow, length = 0.5) annotation(
          Placement(transformation(extent = {{54, 0}, {74, 20}})));
      equation
        connect(source.ports[1], pipe1.port_a) annotation(
