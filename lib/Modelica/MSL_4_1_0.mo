        model RelPositionSensor "Ideal sensor to measure the relative position between two flanges"
          extends Translational.Interfaces.PartialRelativeSensor;
          Modelica.Blocks.Interfaces.RealOutput s_rel(unit = "m") "Relative distance between two flanges (= flange_b.s - flange_a.s) as output signal" annotation(
            Placement(transformation(extent = {{-10, -10}, {10, 10}}, rotation = 270, origin = {0, -110})));
        equation
          s_rel = flange_b.s - flange_a.s;
          0 = flange_a.f;
          annotation(
