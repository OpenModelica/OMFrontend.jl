          Polyphase.Ideal.OpenerWithArc idealOpener(final m = m, Ron = fill(Ron, m), Goff = fill(Goff, m), V0 = fill(V0, m), dVdt = fill(dVdt, m), Vmax = fill(Vmax, m), openerWithArc(off(start = fill(true, m), fixed = fill(true, m)))) annotation(
