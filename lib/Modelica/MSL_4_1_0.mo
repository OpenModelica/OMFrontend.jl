          Modelica.Blocks.Interfaces.RealOutput a_rel(unit = "m/s2") "Relative acceleration between two flanges (= der(v_rel)) as output signal" annotation(
            Placement(transformation(extent = {{-10, -10}, {10, 10}}, rotation = 270, origin = {0, -110})));
        equation
          s_rel = flange_b.s - flange_a.s;
          v_rel = der(s_rel);
