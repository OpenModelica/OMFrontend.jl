          connect(c2.p, mn3.G) annotation(
            Line(points = {{-2, -20}, {2, -20}, {2, -20.1}, {6, -20.1}}, color = {0, 0, 255}));
          connect(mn3.G, mp3.G) annotation(
            Line(points = {{6, -20.1}, {6, 29.9}}, color = {0, 0, 255}));
          connect(c3.p, mn4.G) annotation(
