</p>

</html>"),
              Icon(graphics = {Text(extent = {{-30, -10}, {30, -70}}, textColor = {64, 64, 64}, textString = "A"), Line(points = {{70, 0}, {90, 0}}, color = {85, 170, 255}), Line(points = {{-70, 0}, {-90, 0}}, color = {85, 170, 255}), Line(points = {{100, 0}, {-100, 0}}, color = {85, 170, 255})}));
          end CurrentSensor;

          model CurrentQuasiRMSSensor "Continuous quasi current RMS sensor for polyphase system"
