        function dDewEntropy_dPressure "Derivative of vapor specific entropy in two-phase region w.r.t. pressure | use setState_phX function for input"
          extends Modelica.Icons.Function;
          input SaturationProperties sat "Saturation properties | pressure is used for interpolation";
          output Real dsvdp "Derivative of vapor specific entropy in two-phase region w.r.t. pressure";
        protected
          constant Real sv_coef[:, :] = R134aData.svcoef "Coefficients of cubic spline for s_vap(p)";
          constant Real p_breaks[:] = R134aData.pbreaks "Grid points of reduced pressure";
