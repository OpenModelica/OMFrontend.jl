          Internal.BasicCutTorque cutTorque(resolveInFrame = resolveInFrame, positiveSign = positiveSign) annotation(
            Placement(transformation(extent = {{-62, -10}, {-42, 10}})));
          Modelica.Mechanics.MultiBody.Interfaces.ZeroPosition zeroPosition if not (resolveInFrame == Modelica.Mechanics.MultiBody.Types.ResolveInFrameA.frame_resolve) annotation(
            Placement(transformation(extent = {{-20, -40}, {0, -20}})));
        equation
          connect(cutTorque.frame_a, frame_a) annotation(
