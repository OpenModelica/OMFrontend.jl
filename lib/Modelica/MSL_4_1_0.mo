      package Types "Type definitions"
        extends Modelica.Icons.TypesPackage;
        type ImpulseApproximation = enumeration(DoubleExp "Double exponential function", Heidler "Heidler function") "Enumeration defining the approximation of impulse trajectory";
      end Types;
      annotation(
