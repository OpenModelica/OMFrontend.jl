          Modelica.Electrical.Analog.Sources.StepVoltage V(startTime = 1, offset = 0, V = 1) annotation(
            Placement(transformation(origin = {-100, -10}, extent = {{-10, -10}, {10, 10}}, rotation = 270)));
        equation
          connect(R1.n, C1.p) annotation(
            Line(points = {{-80, 30}, {-60, 30}, {-60, -10}}, color = {0, 0, 255}));
          connect(C1.n, G.p) annotation(
            Line(points = {{-60, -30}, {-60, -50}, {0, -50}, {0, -70}}, color = {0, 0, 255}));
          connect(L1.p, C2.p) annotation(
