                connect(rampCurrent3.n, smee3.pin_ep) annotation(
                  Line(points = {{-30, -70}, {-20, -70}, {-20, -74}, {-10, -74}}, color = {0, 0, 255}));
                connect(smee3.plug_sn, terminalBox3.plug_sn) annotation(
                  Line(points = {{-6, -70}, {-6, -70}}, color = {0, 0, 255}));
                connect(smee3.plug_sp, terminalBox3.plug_sp) annotation(
                  Line(points = {{6, -70}, {6, -70}}, color = {0, 0, 255}));
                connect(smeeM.flange, mechanicalPowerSensorM.flange_a) annotation(
