              connect(ground.p, sinevoltage_p.n) annotation(
                Line(points = {{-90, -40}, {-90, 0}, {-80, 0}, {-80, 4}}, color = {0, 0, 255}));
              connect(sinevoltage_p.p, rectifier.ac_p) annotation(
                Line(points = {{-80, 24}, {-80, 46}, {-40, 46}}, color = {0, 0, 255}));
              connect(sinevoltage_n.n, rectifier.ac_n) annotation(
                Line(points = {{-80, -23.9999}, {-80, -32}, {-50, -32}, {-50, 34}, {-40, 34}}, color = {0, 0, 255}));
              connect(ground.p, currentSensor.n) annotation(
