            connect(diode5.n, capacitor1.p) annotation(
              Line(points = {{70, 30}, {90, 30}}, color = {0, 0, 255}));
            connect(resistorL.p, capacitor1.p) annotation(
              Line(points = {{120, 5}, {120, 30}, {90, 30}}, color = {0, 0, 255}));
            connect(transformer.n1, inductor1.p) annotation(
              Line(points = {{-20, 1}, {-10, 1}, {-10, 14}}, color = {0, 0, 255}));
            connect(transformer.n2, inductor2.p) annotation(
