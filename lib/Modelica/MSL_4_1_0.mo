        model ClockedWithDiscretizedContinuousController "Simple controlled drive with discretized continuous-time controller"
          extends Modelica.Icons.Example;
          Modelica.Mechanics.Rotational.Components.Inertia load(J = 10, phi(fixed = true, start = 0), w(fixed = true, start = 0)) annotation(
            Placement(transformation(extent = {{69, 0}, {89, 20}})));
          Modelica.Mechanics.Rotational.Sensors.SpeedSensor speed annotation(
            Placement(transformation(extent = {{-10, -10}, {6, 6}}, rotation = -90, origin = {97, -9})));
          Modelica.Blocks.Sources.Ramp ramp(duration = 2) annotation(
            Placement(transformation(extent = {{-101, 0}, {-81, 20}})));
