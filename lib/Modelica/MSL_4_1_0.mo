                Dialog(group = "Generic variables"));
              SI.Length perimeter = Modelica.Constants.pi*0.1 "Wetted perimeter" annotation(
                Dialog(group = "Generic variables"));
            end General;

            record HelicalPipe "Input for helical pipe"
