          equation
            connect(rtb.n, Tr.B) annotation(
              Line(points = {{-60, 0}, {-20, 0}}));
            connect(rtb.n, ct.p) annotation(
              Line(points = {{-60, 0}, {-40, 0}, {-40, -20}}));
            connect(ct.n, Ground1.p) annotation(
