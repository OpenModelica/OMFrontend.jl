        model DFFREG "Pulse triggered D-Register-Bank, high active reset"
          import L = Modelica.Electrical.Digital.Interfaces.Logic;
          extends Modelica.Icons.Example;
          Modelica.Electrical.Digital.Sources.Table clock(x = {L.'0', L.'1', L.'0', L.'1', L.'0', L.'1', L.'0'}, t = {0, 7, 8, 10, 11, 15, 16}) annotation(
            Placement(transformation(extent = {{-86, -32}, {-66, -12}})));
