          Pipes.StaticPipe pipeB2B3(redeclare package Medium = BatchMedium, length = 1, redeclare model FlowModel = Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow, diameter = pipeDiameter, height_ab = -0.1) annotation(
            Placement(transformation(extent = {{50, 134}, {30, 154}})));
