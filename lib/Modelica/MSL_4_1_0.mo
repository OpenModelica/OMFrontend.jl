            connect(inductor1.n, diode1.p) annotation(
              Line(points = {{10, 14}, {10, 0}, {30, 0}, {30, 10}}, color = {0, 0, 255}));
            connect(resistorL.n, capacitor2.n) annotation(
              Line(points = {{120, -15}, {120, -40}, {90, -40}}, color = {0, 0, 255}));
            connect(transformer.starPoint1, ground1.p) annotation(
