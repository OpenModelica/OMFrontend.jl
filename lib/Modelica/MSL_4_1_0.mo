        Sources.TimeTable timeTable(table = [0, 0; 1, 2.1; 2, 4.2; 3, 6.3; 4, 4.2; 6, 2.1; 6, 2.1]) annotation(
          Placement(transformation(extent = {{-80, 60}, {-60, 80}})));
