            Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Ellipse(extent = {{-64, 0}, {-14, -50}}, fillColor = {215, 215, 215}, fillPattern = FillPattern.Solid), Ellipse(extent = {{12, 52}, {62, 2}}, fillColor = {215, 215, 215}, fillPattern = FillPattern.Solid)}));
