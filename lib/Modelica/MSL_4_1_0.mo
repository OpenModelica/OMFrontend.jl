        model ControlledIdealClosingSwitch "Controlled ideal electrical closer"
          parameter SI.Voltage level = 0.5 "Switch level";
          extends Modelica.Electrical.Analog.Interfaces.IdealSwitch;
          Modelica.Electrical.Analog.Interfaces.Pin control "Control pin: control.v > level switch closed, otherwise switch open" annotation(
            Placement(transformation(origin = {0, 100}, extent = {{-10, -10}, {10, 10}}, rotation = 90)));
        equation
          off = control.v < level;
          control.i = 0;
          annotation(
            defaultComponentName = "switch",
