          connect(mp3.S, mn3.D) annotation(
            Line(points = {{16, 20}, {16, -10}}, color = {0, 0, 255}));
          connect(mp4.S, mn4.D) annotation(
            Line(points = {{56, 20}, {56, -10}}, color = {0, 0, 255}));
          connect(mn3.S, ground.p) annotation(
            Line(points = {{16, -30}, {16, -60}, {-64, -60}}, color = {0, 0, 255}));
          connect(mn4.S, ground.p) annotation(
            Line(points = {{56, -30}, {56, -60}, {-64, -60}}, color = {0, 0, 255}));
          connect(c3.p, mn3.D) annotation(
            Line(points = {{36, -20}, {36, 0}, {16, 0}, {16, -10}}, color = {0, 0, 255}));
          connect(c4.p, mn4.D) annotation(
