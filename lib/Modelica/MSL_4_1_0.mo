              Basic.Resistor r2(R = R2) annotation(
                Placement(transformation(extent = {{30, 20}, {10, 40}})));
              Basic.Capacitor c(C = C) annotation(
                Placement(transformation(extent = {{60, 20}, {40, 40}})));
            equation
              connect(n1, n2) annotation(
                Line(points = {{-100, -100}, {100, -100}}, color = {0, 0, 255}));
              connect(opAmp.out, p2) annotation(
