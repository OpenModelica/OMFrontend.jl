              parameter SI.Voltage VSupply = 15 "Supply voltage" annotation(
                Dialog(group = "OpAmp"));
              parameter Real k = 100 "Attenuation factor" annotation(
                Dialog(group = "OpAmp"));
              parameter SI.Resistance R1 = 100e3 "Resistor 1" annotation(
                Dialog(group = "OpAmp"));
              parameter SI.Resistance R2 = R1 "Resistor 2" annotation(
                Dialog(group = "OpAmp"));
              parameter SI.Resistance R3 = R1/k "Resistor 3" annotation(
                Dialog(group = "OpAmp"));
              parameter SI.Resistance R4 = R3 "Resistor 4" annotation(
                Dialog(group = "OpAmp"));
              parameter SI.Resistance RInstrument = 100e3 "Input resistance of instrument" annotation(
