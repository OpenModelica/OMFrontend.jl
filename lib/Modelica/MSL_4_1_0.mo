            Semiconductors.NPN Tr(Bf = 50, Br = 0.1, Is = 1e-16, Vak = 0.02, Tauf = 0.12e-9, Taur = 5e-9, Ccs = 1e-12, Cje = 0.4e-12, Cjc = 0.5e-12, Phie = 0.8, Me = 0.4, Phic = 0.8, Mc = 0.333, Gbc = 1e-15, Gbe = 1e-15, Vt = 0.02585, UIC = true) annotation(
