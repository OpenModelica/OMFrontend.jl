          parameter SI.Conductance Goff[m](final min = zeros(m), start = fill(1e-5, m)) "Opened thyristor conductance";
          parameter SI.Voltage Vknee[m](final min = zeros(m), start = zeros(m)) "Threshold voltage";
          Boolean off[m] = idealThyristor.off "Alias of boolean thyristor off";
