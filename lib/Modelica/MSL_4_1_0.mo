            Icon(coordinateSystem(preserveAspectRatio = true, extent = {{-100, -100}, {100, 100}}), graphics = {Text(extent = {{152, -160}, {-148, -100}}, textColor = {0, 0, 255}, textString = "%name"), Rectangle(extent = {{-50, 100}, {50, -100}}, lineThickness = 0.5, fillColor = {213, 170, 255}, fillPattern = FillPattern.Solid), Text(extent = {{-18, -60}, {20, -100}}, textString = "Gate"), Text(extent = {{-50, 80}, {50, 40}}, textString = "1")}));
        end BufGate;
