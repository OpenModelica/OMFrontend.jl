            function autumn "Returns the \"autumn\" color map"
              extends Modelica.Mechanics.MultiBody.Interfaces.partialColorMap;
            algorithm
              if n_colors > 1 then
                colorMap := 255*[fill(1, n_colors), linspace(0, 1., n_colors), zeros(n_colors)];
              else
                colorMap := 255*[1, 0, 0];
              end if;
              annotation(
                Documentation(info = "<html>
<h4>Syntax</h4>
<blockquote><pre>
