              parameter SI.Time T "Time constant";
              parameter SI.Capacitance C = T/R2 "Calculated capacitance to reach T";
              SI.Voltage v(start = 0) = c.v "Capacitor voltage = state";
              Basic.Resistor r1(R = R1) annotation(
                Placement(transformation(extent = {{-50, 20}, {-30, 40}})));
              Basic.Resistor r2(R = R2) annotation(
                Placement(transformation(extent = {{30, 20}, {10, 40}})));
              Basic.Capacitor c(C = C) annotation(
