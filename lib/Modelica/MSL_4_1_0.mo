                Dialog(group = "Even gap"));
            end EvenGap;

            record General "Input for generic correlation"
              extends Modelica.Icons.Record;
              //choices
              Modelica.Fluid.Dissipation.Utilities.Types.kc_general target = Dissipation.Utilities.Types.kc_general.Finest "Target correlation" annotation(
                Dialog(group = "Generic variables"));
              //geometry
