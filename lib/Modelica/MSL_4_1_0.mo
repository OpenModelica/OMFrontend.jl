            output SI.Velocity a "Speed of sound";
          algorithm
            a := sqrt(max(0, (aux.pd*aux.rho*aux.rho*aux.cv + aux.pt*aux.pt*aux.T)/(aux.rho*aux.rho*aux.cv)));
            annotation(
              Inline = false,
              LateInline = true);
          end velocityOfSound_props_pT;

