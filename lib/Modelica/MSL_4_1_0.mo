          Pipes.DynamicPipe pipeB1B2(redeclare package Medium = BatchMedium, length = 1, diameter = pipeDiameter, height_ab = 0) annotation(
            Placement(transformation(extent = {{0, 230}, {-20, 250}})));
          Pipes.StaticPipe pipeB1B3(redeclare package Medium = BatchMedium, length = 1, redeclare model FlowModel = Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow, diameter = pipeDiameter, height_ab = -0.1) annotation(
